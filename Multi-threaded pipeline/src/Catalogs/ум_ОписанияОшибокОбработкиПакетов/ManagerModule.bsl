	ОбъектОписанияОшибок = ОписанияОшибок.ПолучитьОбъект();
	ОбъектОписанияОшибок.ВключитьВОбщийСписокОшибок = Истина;
	ОбъектОписанияОшибок.Записать();
	
	ОписанияОшибок = Справочники.ум_ОписанияОшибокОбработкиПакетов.КонтрольРабочихФЗ_ОтмененоРабочееФЗ;
	ОбъектОписанияОшибок = ОписанияОшибок.ПолучитьОбъект();
	ОбъектОписанияОшибок.ВключитьВОбщийСписокОшибок = Истина;
