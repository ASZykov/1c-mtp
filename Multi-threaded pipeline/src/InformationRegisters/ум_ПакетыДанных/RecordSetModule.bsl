#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	Перем ОтключитьКонтрольВОбработке;
	
	ДополнительныеСвойства.Свойство("ОтключитьКонтрольВОбработке", ОтключитьКонтрольВОбработке);
	
	Если Не ОтключитьКонтрольВОбработке = Истина Тогда
		
		МассивИДПакетов = Новый Массив;
		Если ЭтотОбъект.Количество() Тогда
			Для каждого Запись Из ЭтотОбъект Цикл
				МассивИДПакетов.Добавить(Запись.ИдентификаторПакета);
			КонецЦикла;
		Иначе
			ИдентификаторПакета = ЭтотОбъект.Отбор.ИдентификаторПакета.Значение;
			Если ЗначениеЗаполнено(ИдентификаторПакета) Тогда
				МассивИДПакетов.Добавить(ИдентификаторПакета)
			КонецЕсли;
		КонецЕсли;
		
		Если ПакетВОбработке(МассивИДПакетов) Тогда
			ВызватьИсключение "Пакет находится в обработке.";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПакетВОбработке(МассивИДПакетов)
	
	Если Не ЗначениеЗаполнено(МассивИДПакетов) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаИДПакетов = Новый ТаблицаЗначений;
	ТаблицаИДПакетов.Колонки.Добавить("ИдентификаторПакета", Новый ОписаниеТипов("УникальныйИдентификатор"));
	Для каждого ЭлементМассива из МассивИДПакетов Цикл
		НоваяСтрока = ТаблицаИДПакетов.Добавить();
		НоваяСтрока.ИдентификаторПакета = ЭлементМассива;
	КонецЦикла;
	
	Результат = ум_ИзменениеПакетовДанных.ЕстьПакетыВОбработке(ТаблицаИДПакетов);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли